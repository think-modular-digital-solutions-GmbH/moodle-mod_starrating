{{!
    @template filter_rating/mobile_course_ratings

    The ratings tab of a course in the Moodle app.

    This is rendered on the server and handed to the app, which compiles the
    result as one of its own templates. Every star carries the app's
    core-site-plugins-call-ws directive, so tapping it calls
    filter_rating_set_rating and reloads the tab. No JavaScript is involved.

    The params attribute is an Angular expression, already quoted and escaped by
    the PHP side, which is why it is written as a bound [params] attribute.

    Context variables required for this template:
    * hasitems bool Whether the course offers any criterion
    * emptytext string Shown when it does not
    * canrate bool Whether the user may rate
    * cleartext string Visible text of the withdraw button
    * successmessage string Confirmation the app shows after a rating
    * items array List of criterion, statustext, averagetext, stars, canclear, clearparams, clearlabel
    * items[].stars array List of on, params and label

    Example context (json):
    {
        "hasitems": true,
        "emptytext": "Nothing to rate in this course yet.",
        "canrate": true,
        "cleartext": "Withdraw",
        "successmessage": "Your rating was saved.",
        "items": [
            {
                "criterion": "teaching quality",
                "statustext": "Your rating for teaching quality: 3 of 5 stars",
                "averagetext": "Average 3.8 of 5 from 12 ratings",
                "canclear": true,
                "clearparams": "{contextid: 42, criterion: 'teaching quality', rating: 0}",
                "clearlabel": "Withdraw your rating for teaching quality",
                "stars": [
                    {"on": true, "params": "{contextid: 42, criterion: 'teaching quality', rating: 1}", "label": "Rate teaching quality with 1 of 5 stars"},
                    {"on": true, "params": "{contextid: 42, criterion: 'teaching quality', rating: 2}", "label": "Rate teaching quality with 2 of 5 stars"},
                    {"on": true, "params": "{contextid: 42, criterion: 'teaching quality', rating: 3}", "label": "Rate teaching quality with 3 of 5 stars"},
                    {"on": false, "params": "{contextid: 42, criterion: 'teaching quality', rating: 4}", "label": "Rate teaching quality with 4 of 5 stars"},
                    {"on": false, "params": "{contextid: 42, criterion: 'teaching quality', rating: 5}", "label": "Rate teaching quality with 5 of 5 stars"}
                ]
            }
        ]
    }
}}
{{^hasitems}}
    <ion-list>
        <ion-item class="ion-text-wrap">
            <ion-label>{{emptytext}}</ion-label>
        </ion-item>
    </ion-list>
{{/hasitems}}
{{#hasitems}}
    <ion-list class="filter-rating-app-list">
        {{#items}}
            <ion-item class="ion-text-wrap" lines="none">
                <ion-label>
                    <h2>{{criterion}}</h2>
                    <p>{{averagetext}}</p>
                    <p>{{statustext}}</p>
                </ion-label>
            </ion-item>
            <ion-item class="ion-text-wrap" lines="full">
                <div class="filter-rating filter-rating-app" role="group" aria-label="{{criterion}}">
                    {{#canrate}}
                        {{#stars}}
                            <a core-site-plugins-call-ws name="filter_rating_set_rating"
                                [params]="{{params}}"
                                [preSets]="{getFromCache: 0, saveToCache: 0}"
                                refreshOnSuccess="true"
                                successMessage="{{successmessage}}"
                                class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}"
                                aria-label="{{label}}">
                                <ion-icon name="{{#on}}fas-star{{/on}}{{^on}}far-star{{/on}}" aria-hidden="true"></ion-icon>
                            </a>
                        {{/stars}}
                    {{/canrate}}
                    {{^canrate}}
                        {{#stars}}
                            <span class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}">
                                <ion-icon name="{{#on}}fas-star{{/on}}{{^on}}far-star{{/on}}" aria-hidden="true"></ion-icon>
                            </span>
                        {{/stars}}
                    {{/canrate}}
                </div>
                {{#canclear}}
                    <ion-button slot="end" fill="clear" size="small"
                        core-site-plugins-call-ws name="filter_rating_set_rating"
                        [params]="{{clearparams}}"
                        [preSets]="{getFromCache: 0, saveToCache: 0}"
                        refreshOnSuccess="true"
                        aria-label="{{clearlabel}}">{{cleartext}}</ion-button>
                {{/canclear}}
            </ion-item>
        {{/items}}
    </ion-list>
{{/hasitems}}
