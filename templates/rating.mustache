{{!
    @template filter_rating/rating

    Interactive five star rating.

    Each star is a real link, so rating works without JavaScript. The Moodle app
    ignores the href and follows data-app-url instead, which opens the same
    endpoint in the app browser and refreshes the content afterwards.

    A rated star is fa-star, an unrated one fa-star-o. Both render everywhere the
    plugin supports: FontAwesome 4 knows fa-star-o natively, FontAwesome 6 maps
    it to the regular family through Moodle's v4 shims, and the app resolves the
    -o suffix to its regular SVG library.

    Context variables required for this template:
    * criterion string The criterion being rated
    * contextid int Context the widget is displayed in
    * courseid int Course the criterion belongs to
    * userrating int Stars the current user gave, 0 when not rated
    * count int Number of ratings
    * average float Average rating
    * canrate bool Whether the current user may rate
    * stars array List of value, on, url, appurl and label
    * grouplabel string Accessible name of the whole widget
    * statustext string The current user rating in words
    * showaverage bool Whether to show the average
    * averagetext string The average in words
    * canclear bool Whether the withdraw link is shown
    * clearurl string Link that withdraws the rating
    * clearappurl string The same link for the Moodle app
    * clearlabel string Visible text of the withdraw link
    * clearaltlabel string Accessible name of the withdraw link

    Example context (json):
    {
        "criterion": "teaching quality",
        "contextid": 42,
        "courseid": 7,
        "userrating": 3,
        "count": 12,
        "average": 3.8,
        "canrate": true,
        "stars": [
            {"value": 1, "on": true, "url": "#", "appurl": "#", "label": "Rate teaching quality with 1 of 5 stars"},
            {"value": 2, "on": true, "url": "#", "appurl": "#", "label": "Rate teaching quality with 2 of 5 stars"},
            {"value": 3, "on": true, "url": "#", "appurl": "#", "label": "Rate teaching quality with 3 of 5 stars"},
            {"value": 4, "on": false, "url": "#", "appurl": "#", "label": "Rate teaching quality with 4 of 5 stars"},
            {"value": 5, "on": false, "url": "#", "appurl": "#", "label": "Rate teaching quality with 5 of 5 stars"}
        ],
        "grouplabel": "Star rating for teaching quality",
        "statustext": "Your rating for teaching quality: 3 of 5 stars",
        "showaverage": true,
        "averagetext": "Average 3.8 of 5 from 12 ratings",
        "canclear": true,
        "clearurl": "#",
        "clearappurl": "#",
        "clearlabel": "Withdraw",
        "clearaltlabel": "Withdraw your rating for teaching quality"
    }
}}
<span class="filter-rating" role="group" aria-label="{{grouplabel}}"
    data-criterion="{{criterion}}"
    data-contextid="{{contextid}}"
    data-courseid="{{courseid}}"
    data-userrating="{{userrating}}"
    data-count="{{count}}"
    data-average="{{average}}"
    data-canrate="{{#canrate}}1{{/canrate}}{{^canrate}}0{{/canrate}}">
    <span class="sr-only visually-hidden" data-region="status">{{statustext}}</span>
    <span class="filter-rating-stars" data-region="stars">
        {{#stars}}
            {{#canrate}}
                <a href="{{url}}" class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}"
                    data-value="{{value}}" aria-label="{{label}}" title="{{label}}"
                    data-app-url="{{appurl}}" data-app-open-in="inappbrowser" data-app-url-resume-action="refresh">
                    <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}" aria-hidden="true"></i>
                </a>
            {{/canrate}}
            {{^canrate}}
                <span class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}"
                    data-value="{{value}}">
                    <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}" aria-hidden="true"></i>
                </span>
            {{/canrate}}
        {{/stars}}
    </span>
    {{#showaverage}}
        <span class="filter-rating-average" data-region="average">{{averagetext}}</span>
    {{/showaverage}}
    {{#canclear}}
        <a href="{{clearurl}}" class="filter-rating-clear" data-region="clear" aria-label="{{clearaltlabel}}"
            data-app-url="{{clearappurl}}" data-app-open-in="inappbrowser" data-app-url-resume-action="refresh">{{clearlabel}}</a>
    {{/canclear}}
</span>
