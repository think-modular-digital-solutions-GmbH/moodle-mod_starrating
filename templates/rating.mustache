{{!
    @template mod_starrating/rating

    The stars of a star rating activity, on the web. How many there are is a per
    activity setting, two to ten, so the template never assumes five.

    Rendered inline on the course page the way a label renders its text, and
    again on the activity page. Every star is a real link, so rating works
    without JavaScript.

    A rated star is fa-star, an unrated one fa-star-o. Both render on every
    FontAwesome version Moodle has shipped, the v4 shims mapping fa-star-o to
    the regular family.

    Context variables required for this template:
    * cmid int Course module id
    * name string Name of the activity, which is the criterion
    * showname bool Whether to show the name above the stars
    * userrating int Stars the current user gave, 0 when not rated
    * maxstars int Length of the rating scale
    * count int Number of ratings
    * average float Average rating
    * canrate bool Whether the current user may rate
    * stars array List of value, on, url and label
    * grouplabel string Accessible name of the whole widget
    * statustext string The current user rating in words
    * showaverage bool Whether to show the average
    * averagetext string The average in words
    * canclear bool Whether the withdraw link is shown
    * clearurl string Link that withdraws the rating
    * clearlabel string Visible text of the withdraw link
    * clearaltlabel string Accessible name of the withdraw link

    Example context (json):
    {
        "cmid": 12,
        "name": "Teaching quality",
        "showname": true,
        "userrating": 3,
        "maxstars": 5,
        "count": 12,
        "average": 3.8,
        "canrate": true,
        "stars": [
            {"value": 1, "on": true, "url": "#", "label": "Rate Teaching quality with 1 of 5 stars"},
            {"value": 2, "on": true, "url": "#", "label": "Rate Teaching quality with 2 of 5 stars"},
            {"value": 3, "on": true, "url": "#", "label": "Rate Teaching quality with 3 of 5 stars"},
            {"value": 4, "on": false, "url": "#", "label": "Rate Teaching quality with 4 of 5 stars"},
            {"value": 5, "on": false, "url": "#", "label": "Rate Teaching quality with 5 of 5 stars"}
        ],
        "grouplabel": "Star rating for Teaching quality",
        "statustext": "Your rating for Teaching quality: 3 of 5 stars",
        "showaverage": true,
        "averagetext": "Average 3.8 of 5 from 12 ratings",
        "canclear": true,
        "clearurl": "#",
        "clearlabel": "Withdraw",
        "clearaltlabel": "Withdraw your rating for Teaching quality"
    }
}}
<div class="starrating-activity" data-cmid="{{cmid}}" data-userrating="{{userrating}}"
    data-maxstars="{{maxstars}}" data-count="{{count}}" data-average="{{average}}">
    {{#showname}}
        <span class="starrating-name">{{name}}</span>
    {{/showname}}
    <span class="filter-rating" role="group" aria-label="{{grouplabel}}">
        <span class="sr-only visually-hidden" data-region="status">{{statustext}}</span>
        <span class="filter-rating-stars" data-region="stars">
            {{#stars}}
                {{#canrate}}
                    <a href="{{url}}" class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}"
                        data-value="{{value}}" aria-label="{{label}}" title="{{label}}">
                        <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}" aria-hidden="true"></i>
                    </a>
                {{/canrate}}
                {{^canrate}}
                    <span class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}"
                        data-value="{{value}}">
                        <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}" aria-hidden="true"></i>
                    </span>
                {{/canrate}}
            {{/stars}}
        </span>
        {{#showaverage}}
            <span class="filter-rating-average" data-region="average">{{averagetext}}</span>
        {{/showaverage}}
        {{#canclear}}
            <a href="{{clearurl}}" class="filter-rating-clear" data-region="clear"
                aria-label="{{clearaltlabel}}">{{clearlabel}}</a>
        {{/canclear}}
    </span>
</div>
