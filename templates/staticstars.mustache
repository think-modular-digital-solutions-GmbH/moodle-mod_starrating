{{!
    @template filter_rating/staticstars

    Read only star display used for averages in the report. The stars are
    decorative, the value is stated as text next to them.

    Context variables required for this template:
    * stars array List of on flags
    * label string The average in words

    Example context (json):
    {
        "stars": [{"on": true}, {"on": true}, {"on": true}, {"on": true}, {"on": false}],
        "label": "Average 3.8 of 5 from 12 ratings"
    }
}}
<span class="filter-rating filter-rating-static">
    <span class="filter-rating-stars" aria-hidden="true">
        {{#stars}}
            <span class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}">
                <i class="fa fa-star"></i>
            </span>
        {{/stars}}
    </span>
    <span class="filter-rating-average">{{label}}</span>
</span>
