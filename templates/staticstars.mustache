{{!
    @template mod_starrating/staticstars

    @copyright  2026 Think Modular
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Read only star display used for averages in the report. The stars are
    decorative, the value is stated as text next to them, and there are as many
    as the scale of the activity is long.

    Context variables required for this template:
    * stars array List of on flags
    * label string The average in words

    Example context (json):
    {
        "stars": [{"on": true}, {"on": true}, {"on": true}, {"on": true}, {"on": false}],
        "label": "Average 3.8 of 5 from 12 ratings"
    }
}}
<span class="starrating-widget starrating-static">
    <span class="starrating-stars" aria-hidden="true">
        {{#stars}}
            <span class="starrating-star {{#on}}starrating-on{{/on}}{{^on}}starrating-off{{/on}}">
                <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}"></i>
            </span>
        {{/stars}}
    </span>
    <span class="starrating-average">{{label}}</span>
</span>
