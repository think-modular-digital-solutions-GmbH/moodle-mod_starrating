{{!
    @template mod_starrating/mobile_course_page

    The stars as they appear inline on the course page in the Moodle app.

    The app renders this through core-format-text, so no app directive works
    here. The stars are therefore a link to the activity, which the app opens
    natively because it registers a content link handler for every site plugin
    module. The rating itself is given there.

    Context variables required for this template:
    * name string Name of the activity, which is the criterion
    * url string Link to the activity
    * canrate bool Whether the user may rate
    * stars array List of on flags
    * statustext string The current user rating in words
    * showaverage bool Whether to show the average
    * averagetext string The average in words
    * ratelabel string Accessible name of the link

    Example context (json):
    {
        "name": "Teaching quality",
        "url": "https://moodle.example.com/mod/starrating/view.php?id=12",
        "canrate": true,
        "stars": [{"on": true}, {"on": true}, {"on": true}, {"on": false}, {"on": false}],
        "statustext": "Your rating for Teaching quality: 3 of 5 stars",
        "showaverage": true,
        "averagetext": "Average 3.8 of 5 from 12 ratings",
        "ratelabel": "Rate Teaching quality"
    }
}}
<div class="starrating-activity starrating-app-coursepage">
    <span class="starrating-name">{{name}}</span>
    {{#canrate}}
        <a href="{{url}}" class="filter-rating" aria-label="{{ratelabel}}">
            <span class="sr-only visually-hidden">{{statustext}}</span>
            <span class="filter-rating-stars">
                {{#stars}}
                    <span class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}">
                        <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}" aria-hidden="true"></i>
                    </span>
                {{/stars}}
            </span>
        </a>
    {{/canrate}}
    {{^canrate}}
        <span class="filter-rating">
            <span class="sr-only visually-hidden">{{statustext}}</span>
            <span class="filter-rating-stars">
                {{#stars}}
                    <span class="filter-rating-star {{#on}}filter-rating-on{{/on}}{{^on}}filter-rating-off{{/on}}">
                        <i class="fa {{#on}}fa-star{{/on}}{{^on}}fa-star-o{{/on}}" aria-hidden="true"></i>
                    </span>
                {{/stars}}
            </span>
        </span>
    {{/canrate}}
    {{#showaverage}}
        <span class="filter-rating-average">{{averagetext}}</span>
    {{/showaverage}}
</div>
